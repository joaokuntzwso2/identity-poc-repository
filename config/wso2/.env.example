# Not secrets. Copy to var/wso2/lab.env (ignored), chmod 600 and edit there.
WSO2_BASE_URL=https://localhost:9443
WSO2_EXTERNAL_BASE_URL=https://localhost:9443
DEMO_PUBLIC_BASE_URL=http://127.0.0.1:5173
# Must exactly match PUBLIC_ORIGIN of the existing real identity BFF.
DEMO_BFF_BASE_URL=http://127.0.0.1:4000
# Copy issuer string EXACTLY from the OIDC discovery document (not necessarily WSO2_BASE_URL).
# WSO2_OIDC_ISSUER=https://localhost:9443/oauth2/token
# Avoid disabling TLS validation. Set NODE_EXTRA_CA_CERTS to your trusted local lab CA if necessary.
NODE_EXTRA_CA_CERTS=/absolute/path/to/wso2-lab-ca.pem
# WSO2_ADMIN_USER=admin
# WSO2_ADMIN_PASSWORD=...  # load from shell or secret manager, not from tracked files
# WSO2_ORG_API_TOKEN=...   # bearer with organization-scoped API permissions
# WSO2_UPDATED_IMAGE=private.registry/your-entitled-image:updated-7.3.0
# WSO2_BUILD_ATTESTATION_FILE=absolute path to JSON {"release":"7.3.0","update":18}
# DEMO_RESET_OPERATOR_KEY=... # generated with: openssl rand -hex 32
# AWS: never make reset endpoint reachable without real operator SSO + network controls.
