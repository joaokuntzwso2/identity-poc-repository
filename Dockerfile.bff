FROM node:22.16.0-alpine3.21
WORKDIR /app
COPY package.json ./
COPY services/identity-bff/package.json ./services/identity-bff/
COPY services/identity-bff/src ./services/identity-bff/src
COPY config/scenario-catalog.json ./config/
COPY apps/experience-center/fallback.* ./apps/experience-center/
USER node
EXPOSE 4100
CMD ["node", "services/identity-bff/src/server.js"]
