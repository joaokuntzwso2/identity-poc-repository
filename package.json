{
  "name": "poc-identity-experience-center",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @poc/experience-center",
    "prestart:bff": "python3 scripts/p2/partner_v13.py ensure && python3 scripts/p2/partner_access_v14.py status && python3 scripts/p2/partner_business_plan_v15.py status && python3 scripts/p2/partner_portal_v16_3.py bootstrap && python3 scripts/p2/partner_share_v17_2.py bootstrap && python3 scripts/p2/partner_directory_v18.py bootstrap && node scripts/prepare-business-ledgers.mjs",
    "start:bff": "node scripts/ciam-live-start.mjs",
    "ciam:preflight": "node scripts/ciam-live-start.mjs --check",
    "ciam:smoke": "node scripts/ciam-live-smoke.mjs",
    "ciam:registrations": "python3 scripts/ciam-live-registrations.py",
    "test": "node --test services/identity-bff/test/*.test.js",
    "check": "npm test && node scripts/preflight.mjs",
    "build": "npm run build --workspace @poc/experience-center",
    "test:pairwise-live": "node scripts/run-live-pairwise.mjs",
    "identity:test": "node --test services/identity-bff/test/identity-*.test.js",
    "identity:audit": "node scripts/identity/release-gates.mjs",
    "identity:phase1": "node scripts/identity/phase1-preflight.mjs",
    "identity:exchange": "node scripts/identity/token-exchange-live.mjs",
    "identity:db:migrate": "node scripts/identity/db-migrate.mjs",
    "ciam:p119:email": "python3 scripts/wso2/p119-governance-startup.py email",
    "ciam:p119:plan": "python3 scripts/wso2/p119-governance-startup.py plan",
    "ciam:p119:apply": "python3 scripts/wso2/p119-governance-startup.py apply",
    "ciam:p119:check": "python3 scripts/wso2/p119-governance-startup.py check",
    "ciam:p119:rollback": "python3 scripts/wso2/p119-governance-startup.py rollback",
    "demo:preflight": "node scripts/demo-preflight.mjs",
    "demo:test": "node --test tests/p120-contract.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
