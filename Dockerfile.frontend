FROM node:22.16.0-alpine3.21
WORKDIR /app
COPY package.json ./
COPY apps/experience-center/package.json apps/experience-center/
COPY apps/experience-center/tsconfig.json apps/experience-center/
COPY apps/experience-center/vite.config.ts apps/experience-center/
COPY apps/experience-center/index.html apps/experience-center/
COPY apps/experience-center/src apps/experience-center/src/
RUN npm install --no-audit --no-fund
EXPOSE 5173
CMD ["npm", "run", "dev", "--workspace", "@poc/experience-center"]
