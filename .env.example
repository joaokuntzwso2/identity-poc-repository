# Public URL that receives browser callbacks; include scheme, never a trailing slash.
# npm dev defaults to Vite 5173 with /auth and /api proxying to the BFF.
PUBLIC_ORIGIN=http://localhost:5173
PORT=4100
BIND_HOST=127.0.0.1
ALLOW_INSECURE_LOCAL=true
NODE_ENV=development

# Exact issuer as returned by actual WSO2 Discovery (commonly /oauth2/token).
# In each case the client MUST exist as an independent registration.
OIDC_ISSUER=https://YOUR_WSO2_IDP/oauth2/token
OIDC_AURORA_WEB_CLIENT_ID=
OIDC_AURORA_APP_CLIENT_ID=
OIDC_BRISA_WEB_CLIENT_ID=
OIDC_BRISA_APP_CLIENT_ID=

# If public/client-secretless BFF clients are used, no client secret is needed.
# For registered confidential OIDC clients, store their secrets only in BFF env.
OIDC_AURORA_WEB_CLIENT_SECRET=
OIDC_AURORA_APP_CLIENT_SECRET=
OIDC_BRISA_WEB_CLIENT_SECRET=
OIDC_BRISA_APP_CLIENT_SECRET=

# Optional explicit per-client issuers. If omitted, OIDC_ISSUER is used.
# OIDC_AURORA_WEB_ISSUER=
# OIDC_AURORA_APP_ISSUER=
# OIDC_BRISA_WEB_ISSUER=
# OIDC_BRISA_APP_ISSUER=

# WSO2 also publishes /.well-known/openid-configuration via some deployments.
# Set an explicit discovery URL only if the deployed topology needs it.
# OIDC_DISCOVERY_URL=https://YOUR_WSO2_IDP/oauth2/oidcdiscovery/.well-known/openid-configuration

# Sector identifier URI must be a public valid HTTPS JSON URI, preferably
# https://YOUR_APP_DOMAIN/oidc/sector/aurora.json and /brisa.json.
SECTOR_AURORA_URI=
SECTOR_BRISA_URI=

# Operator-only M2M demonstration. Allowlist format is EXACT iss|sub.
# NEVER embed these credentials in frontend bundles.
OPERATOR_ALLOWLIST=
M2M_ISSUER=
M2M_CLIENT_ID=
M2M_CLIENT_SECRET=
M2M_SCOPES=catalog.read

# Vite proxy host, for Docker network use http://identity-bff:4000
BFF_PROXY_TARGET=http://127.0.0.1:4100

# v0.2 security hardening: demonstration-only consent is DISABLED by default.
# Enable only for local walkthrough. This is not WSO2 consent v2 or LGPD evidence.
ENABLE_EPHEMERAL_CONSENT=false

# Optional explicitly permitted cross-origin discovery endpoints (comma-separated
# exact scheme://host[:port] origins). Leave empty in normal deployments.
OIDC_TRUSTED_ENDPOINT_ORIGINS=

# Optional per-issuer discovery override JSON (key = exact issuer URL).
# OIDC_DISCOVERY_URLS_JSON={"https://idp.example/oauth2/token":"https://idp.example/oauth2/oidcdiscovery/.well-known/openid-configuration"}

# IDENTITY AE consent prototype (DO NOT commit .env or database credentials)
IDENTITY_CONSENT_DATABASE_URL=
# Required in production to validate the PostgreSQL server CA
IDENTITY_PG_SSL_CA_FILE=
# For G0 product update/build verification (local file only)
WSO2_BUILD_ATTESTATION_FILE=
# RFC 8693 actor demo: owner-only real signed token files, never browser/localStorage
IDENTITY_SUBJECT_TOKEN_FILE=
IDENTITY_ACTOR_TOKEN_FILE=
IDENTITY_EXCHANGE_SCOPE=order.read
IDENTITY_EXCHANGE_AUDIENCE=
